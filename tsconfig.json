{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@organisation-tree/core": ["dist/core"],
      "@organisation-tree/organisation": ["dist/organisation"],
      "@organisation-tree/angular": ["dist/angular"]
    }
  },
  "angularCompilerOptions": { "strictTemplates": true }
}
